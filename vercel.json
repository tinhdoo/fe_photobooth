{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "regions": ["sin1"],
  "functions": {
    "api/sessions.js": { "maxDuration": 60 },
    "api/codes.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/sessions?action=cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/codes?action=cleanup",
      "schedule": "30 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
